{
  "name": "context-copier",
  "displayName": "Context Copier",
  "description": "Quickly copy or combine file paths and contents for use in AI prompts or documentation.",
  "version": "1.0.0",
  "publisher": "mumer01",
  "icon": "images/icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "context",
    "prompt",
    "ai",
    "copy",
    "llm",
    "chatgpt",
    "claude"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/MUmer01/context-copier"
  },
  "bugs": {
    "url": "https://github.com/MUmer01/context-copier/issues"
  },
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "context-copier.copySelectedFiles",
        "title": "Context Copier: Copy Path & Content of Selected File(s)",
        "category": "Context Copier"
      },
      {
        "command": "context-copier.openAllFolderFiles",
        "title": "Context Copier: Open All Files in Folder",
        "category": "Context Copier"
      },
      {
        "command": "context-copier.copySelectedTab",
        "title": "Context Copier: Copy Path & Content of This Tab",
        "category": "Context Copier"
      },
      {
        "command": "context-copier.aggregateSelectedTab",
        "title": "Context Copier: Combine This Tab into New File",
        "category": "Context Copier"
      },
      {
        "command": "context-copier.copyCurrentFile",
        "title": "Context Copier: Copy Path & Content of Active File",
        "category": "Context Copier"
      },
      {
        "command": "context-copier.copyAllTabs",
        "title": "Context Copier: Copy Path & Content of All Open Tabs",
        "category": "Context Copier"
      },
      {
        "command": "context-copier.aggregateAllTabs",
        "title": "Context Copier: Combine All Open Tabs into New File",
        "category": "Context Copier"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "context-copier.copySelectedFiles",
          "when": "!explorerResourceIsFolder",
          "group": "7_modification@1"
        },
        {
          "command": "context-copier.openAllFolderFiles",
          "when": "explorerResourceIsFolder",
          "group": "navigation@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "context-copier.copySelectedTab",
          "group": "2_copy_files@1"
        },
        {
          "command": "context-copier.copyAllTabs",
          "group": "2_copy_files@2"
        },
        {
          "command": "context-copier.aggregateSelectedTab",
          "group": "2_copy_files@3"
        },
        {
          "command": "context-copier.aggregateAllTabs",
          "group": "2_copy_files@4"
        }
      ]
    },
    "keybindings": [
      {
        "command": "context-copier.copyCurrentFile",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.7",
    "@types/node": "20.x",
    "@types/vscode": "^1.92.0",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.11.0",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.4.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5"
  }
}
